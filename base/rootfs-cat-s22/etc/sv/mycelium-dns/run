#!/bin/sh
exec 2>&1
# runsv does not export HOME, and the resolver resolves its state directory
# from $HOME/.mycelium and ignores MYCELIUM_HOME. Pin HOME and make the
# packaged state dir reachable through it; drop both once the resolver honours
# MYCELIUM_HOME.
export HOME=/root
if [ ! -L /root/.mycelium ]; then
    [ -e /root/.mycelium ] && mv /root/.mycelium /root/.mycelium.pre-packaged 2>/dev/null
    ln -s /var/lib/mycelium /root/.mycelium
fi
# `mycelium dns resolver init --write` writes the settings; until it has, there
# is no zone to serve and the resolver would fail on every start.
while [ ! -f /var/lib/mycelium/dns/active-settings.json ]; do
    sleep 5
done
exec /usr/bin/mycelium dns resolver run \
    --config /var/lib/mycelium/dns/active-settings.json --write
